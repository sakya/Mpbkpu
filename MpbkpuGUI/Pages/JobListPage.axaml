<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MpbkpuGUI.Pages.JobListPage">
    <DockPanel>
        <Menu Name="Menu" DockPanel.Dock="Top">
            <MenuItem Header="{i18n:Localize _File}">
                <MenuItem Header="{i18n:Localize _NewBackup}"
                          Click="OnNewBackupClick">
                    <MenuItem.Icon>
                        <mi:MaterialIcon Width="14" Height="14" Kind="Archive" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{i18n:Localize _NewSync}"
                          Click="OnNewSyncClick">
                    <MenuItem.Icon>
                        <mi:MaterialIcon Width="14" Height="14" Kind="Sync" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{i18n:Localize _Exit}"
                          Click="OnExitClick">
                    <MenuItem.Icon>
                        <mi:MaterialIcon Width="14" Height="14" Kind="ExitToApp" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{i18n:Localize _Help}">
                <MenuItem Header="{i18n:Localize _About}" InputGesture="F1"
                          Click="OnAboutClick">
                    <MenuItem.Icon>
                        <mi:MaterialIcon Width="14" Height="14" Kind="HelpCircleOutline" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <Grid>
            <controls:ItemsList Name="JobList">
                <controls:ItemsList.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,5,10,5">
                            <controls:JobListItem
                                Item="{Binding}"
                                JobOpen="OnJobOpen"
                                JobRun="OnJobRun"
                                JobSettings="OnJobSettings"
                                JobDelete="OnJobDelete"/>
                        </Border>
                    </DataTemplate>
                </controls:ItemsList.ItemTemplate>
            </controls:ItemsList>
        </Grid>
    </DockPanel>
</UserControl>