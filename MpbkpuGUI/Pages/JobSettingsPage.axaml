<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:MpbkpuGUI.Models"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="740"
             x:Class="MpbkpuGUI.Pages.JobSettingsPage">

    <Design.DataContext>
        <models:JobSettingsPageModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:IsBackupJobConverter x:Key="IsBackupJobConverter"/>
        <converters:EnumToLocalizedStringConverter x:Key="EnumToLocalizedStringConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
            <StackPanel Margin="40,28,40,32" MaxWidth="960" Spacing="20">
                <TextBlock Name="PageHeader" Classes="h1" />

                <!-- General -->
                <Border Classes="card">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="h2" Text="{i18n:Localize General}" />
                        <StackPanel>
                            <Label Content="{i18n:Localize Name}" />
                            <controls:ErrorContainer Name="NameError" FieldName="Name"
                                                     Errors="{Binding $parent.DataContext.Errors}">
                                <controls:ErrorContainer.Control>
                                    <TextBox Name="Name" Text="{Binding $parent[3].DataContext.Job.Name, Mode=TwoWay}" />
                                </controls:ErrorContainer.Control>
                            </controls:ErrorContainer>
                        </StackPanel>
                        <StackPanel IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}">
                            <Label Content="{i18n:Localize Type}" />
                            <ComboBox Name="CmbType" SelectedItem="{Binding Job.Type, Mode=TwoWay}" Width="280" HorizontalAlignment="Left">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}, ConverterParameter=BackupType_}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="hint" Text="{i18n:Localize TypeHint}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Source and destination -->
                <Grid ColumnDefinitions="*,20,*">
                    <Border Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="h2" Text="{i18n:Localize Source}" />
                            <controls:PositionDetail Name="Source" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="card">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="h2" Text="{i18n:Localize Destination}" />
                            <controls:PositionDetail Name="Destination" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- More destinations: the files of a backup are split among all the destinations -->
                <Border Classes="card" IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="h2" Text="{i18n:Localize MoreDestinations}" />
                            <TextBlock Classes="hint" Margin="0" Text="{i18n:Localize MoreDestinationsHint}" />
                        </StackPanel>
                        <StackPanel Name="MoreDestinationsList" Spacing="20" />
                        <Button Click="OnAddDestinationClick" HorizontalAlignment="Left"
                                AutomationProperties.Name="{i18n:Localize AddDestination}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                <TextBlock Text="{i18n:Localize AddDestination}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Files and directories to skip (backup and synchronization) -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="h2" Text="{i18n:Localize Exclude}" />
                            <TextBlock Classes="hint" Margin="0" Text="{i18n:Localize ExcludeHint}" />
                        </StackPanel>
                        <StackPanel Name="ExcludeList" Spacing="8" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Click="OnAddExclusionClick" AutomationProperties.Name="{i18n:Localize AddExclusion}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16" />
                                    <TextBlock Text="{i18n:Localize AddExclusion}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <!-- Pickers only for a local source: their paths are made relative to it -->
                            <StackPanel Name="ExcludeBrowse" Orientation="Horizontal" Spacing="10">
                                <Button Click="OnExcludeFolderClick" AutomationProperties.Name="{i18n:Localize ExcludeFolder}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <mi:MaterialIcon Kind="FolderOutline" Width="16" Height="16" />
                                        <TextBlock Text="{i18n:Localize ExcludeFolder}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnExcludeFileClick" AutomationProperties.Name="{i18n:Localize ExcludeFile}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <mi:MaterialIcon Kind="FileOutline" Width="16" Height="16" />
                                        <TextBlock Text="{i18n:Localize ExcludeFile}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Automatic runs (scheduler of the operating system, Utility/JobScheduler) -->
                <Border Name="ScheduleCard" Classes="card">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="h2" Text="{i18n:Localize Schedule}" />
                            <TextBlock Classes="hint" Margin="0" Text="{i18n:Localize ScheduleHint}" />
                        </StackPanel>
                        <ToggleSwitch Name="ScheduleEnabled" OnContent="{i18n:Localize ScheduleEnabled}"
                                      OffContent="{i18n:Localize ScheduleEnabled}"
                                      AutomationProperties.Name="{i18n:Localize ScheduleEnabled}" />
                        <StackPanel Spacing="12" IsVisible="{Binding #ScheduleEnabled.IsChecked}">
                            <StackPanel Spacing="4">
                                <Label Content="{i18n:Localize ScheduleTime}" />
                                <TimePicker Name="ScheduleTime" ClockIdentifier="24HourClock" VerticalContentAlignment="Center"
                                            AutomationProperties.Name="{i18n:Localize ScheduleTime}" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Label Content="{i18n:Localize ScheduleDays}" />
                                <controls:ErrorContainer FieldName="Schedule" Errors="{Binding $parent.DataContext.Errors}">
                                    <controls:ErrorContainer.Control>
                                        <WrapPanel Name="ScheduleDays" ItemSpacing="8" LineSpacing="8" />
                                    </controls:ErrorContainer.Control>
                                </controls:ErrorContainer>
                            </StackPanel>
                            <TextBlock Name="ScheduleNext" Classes="muted" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Security and compression -->
                <Border Classes="card" IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="h2" Text="{i18n:Localize SecurityCompression}" />
                        <Grid ColumnDefinitions="*,24,*">
                            <StackPanel>
                                <ToggleSwitch IsEnabled="{Binding IsNew}"
                                              IsChecked="{Binding Job.Encrypted, Mode=TwoWay}"
                                              OnContent="{i18n:Localize Encrypted}" OffContent="{i18n:Localize Encrypted}"
                                              AutomationProperties.Name="{i18n:Localize Encrypted}" />
                                <TextBlock Classes="hint" Margin="0" Text="{i18n:Localize EncryptedHint}" />
                                <StackPanel Name="SavedPasswordPanel" Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                                    <TextBlock Classes="muted" VerticalAlignment="Center" Text="{i18n:Localize PasswordSaved}" />
                                    <Button Classes="Small" Click="OnForgetPasswordClick" Content="{i18n:Localize ForgetPassword}"
                                            AutomationProperties.Name="{i18n:Localize ForgetPassword}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="{i18n:Localize CompressionLevel}" />
                                <controls:ErrorContainer FieldName="CompressionLevel"
                                                         Errors="{Binding $parent.DataContext.Errors}">
                                    <controls:ErrorContainer.Control>
                                        <ComboBox Name="CmbCompressionLevel" SelectedItem="{Binding $parent[3].DataContext.Job.CompressionLevel, Mode=TwoWay}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}, ConverterParameter=Compression_}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </controls:ErrorContainer.Control>
                                </controls:ErrorContainer>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Chains and retention -->
                <Border Classes="card" IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="h2" Text="{i18n:Localize Chains}" />
                            <TextBlock Classes="hint" Margin="0" Text="{i18n:Localize ChainsDescription}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,24,*">
                            <StackPanel>
                                <Label Content="{i18n:Localize FullBackupEveryDays}" />
                                <NumericUpDown Value="{Binding Job.FullBackupEveryDays, Mode=TwoWay}" Minimum="0" Maximum="3650" FormatString="0" />
                                <TextBlock Classes="hint" Text="{i18n:Localize FullBackupEveryDaysHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Label Content="{i18n:Localize KeepChains}" />
                                <NumericUpDown Value="{Binding Job.KeepChains, Mode=TwoWay}" Minimum="0" Maximum="1000" FormatString="0" />
                                <TextBlock Classes="hint" Text="{i18n:Localize KeepChainsHint}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Verification -->
                <Border Classes="card" IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="h2" Text="{i18n:Localize Verification}" />
                            <TextBlock Classes="hint" Margin="0" Text="{i18n:Localize VerificationDescription}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,24,*">
                            <StackPanel>
                                <Label Content="{i18n:Localize VerifyAfterBackup}" />
                                <ComboBox Name="CmbVerify" HorizontalAlignment="Stretch"
                                          SelectedItem="{Binding Job.Verify, Mode=TwoWay}"
                                          AutomationProperties.Name="{i18n:Localize VerifyAfterBackup}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}, ConverterParameter=Verify_}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Classes="hint" Text="{i18n:Localize VerifyAfterBackupHint}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Advanced -->
                <Border Classes="card" Padding="8">
                    <Expander Header="{i18n:Localize Advanced}" HorizontalAlignment="Stretch"
                              Background="Transparent" BorderThickness="0" FontWeight="SemiBold">
                        <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto" Margin="8,0,8,8">
                            <ToggleSwitch IsChecked="{Binding !Job.SkipHashCheck, Mode=TwoWay}" FontWeight="Normal"
                                          OnContent="{i18n:Localize HashCheck}" OffContent="{i18n:Localize HashCheck}"
                                          AutomationProperties.Name="{i18n:Localize HashCheck}"
                                          VerticalAlignment="Bottom" Margin="0,0,0,6" />
                            <StackPanel Grid.Column="2">
                                <Label Content="{i18n:Localize RetryOnError}" FontWeight="Normal" />
                                <NumericUpDown Value="{Binding Job.RetryOnError, Mode=TwoWay}" Minimum="1" Maximum="255" FormatString="0" FontWeight="Normal" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,12,0,0"
                                        IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}">
                                <Label Content="{i18n:Localize ParallelFiles}" FontWeight="Normal" />
                                <NumericUpDown Value="{Binding Job.ParallelFiles, Mode=TwoWay}" Minimum="1" Maximum="64" FormatString="0" FontWeight="Normal" />
                                <TextBlock Classes="hint" FontWeight="Normal" Text="{i18n:Localize ParallelFilesHint}" />
                            </StackPanel>
                        </Grid>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="40,14">
            <controls:OkCancelButtons
                MaxWidth="960"
                OkText="{i18n:Localize Save}"
                OkClick="OnOkClick"
                CancelClick="OnCancelClick"/>
        </Border>
    </Grid>
</UserControl>
