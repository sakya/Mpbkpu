<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:MpbkpuGUI.Abstracts"
             xmlns:i="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MpbkpuGUI.Pages.JobSettingsPage">

    <Design.DataContext>
        <local:Job />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:IsBackupJobConverter x:Key="IsBackupJobConverter"/>
    </UserControl.Resources>

    <Grid Margin="5,0,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Label Content="{i18n:Localize Name}" />
                <TextBox Name="Name" Grid.Row="1" Text="{Binding Name, Mode=TwoWay}" />

                <Label Grid.Row="2" Content="{i18n:Localize Type}" Margin="0,5,0,0"
                       IsVisible="{Binding ., Mode=TwoWay, Converter={StaticResource IsBackupJobConverter}}"/>
                <ComboBox Grid.Row="3" Name="CmbType"
                          IsVisible="{Binding ., Mode=TwoWay, Converter={StaticResource IsBackupJobConverter}}"
                          SelectedItem="{Binding Type, Mode=TwoWay}"/>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="{i18n:Localize Source}" Margin="0,5,5,0" />
                    <Border Grid.Row="1" Grid.Column="0"
                            Margin="0,0,5,0"
                            CornerRadius="10" ClipToBounds="True"
                            Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                            BorderBrush="{DynamicResource SystemControlBackgroundBaseHighBrush}"
                            BorderThickness="0.5"
                            Padding="15">
                        <controls:PositionDetail
                            Name="Source"
                            Value="{Binding Source, Mode=TwoWay}" />
                    </Border>

                    <Label Grid.Row="0" Grid.Column="1" Content="{i18n:Localize Destination}" Margin="5,5,0,0" />
                    <Border Grid.Row="1" Grid.Column="1"
                            Margin="5,0,0,0"
                            CornerRadius="10" ClipToBounds="True"
                            Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                            BorderBrush="{DynamicResource SystemControlBackgroundBaseHighBrush}"
                            BorderThickness="0.5"
                            Padding="15">
                        <controls:PositionDetail
                            Name="Destination"
                            Value="{Binding Destination, Mode=TwoWay}" />
                    </Border>
                </Grid>

                <Label Grid.Row="5" Content="{i18n:Localize CompressionLevel}" Margin="0,5,0,0"
                       IsVisible="{Binding ., Mode=TwoWay, Converter={StaticResource IsBackupJobConverter}}"/>
                <ComboBox Grid.Row="6" Name="CmbCompressionLevel"
                          IsVisible="{Binding ., Mode=TwoWay, Converter={StaticResource IsBackupJobConverter}}"
                          SelectedItem="{Binding CompressionLevel, Mode=TwoWay}"/>

                <Label Grid.Row="7" Content="{i18n:Localize HashCheck}" Margin="0,5,0,0" />
                <CheckBox Grid.Row="8" IsChecked="{Binding !SkipHashCheck, Mode=TwoWay}"></CheckBox>

                <Label Grid.Row="9" Content="{i18n:Localize RetryOnError}" Margin="0,5,0,0" />
                <NumericUpDown Grid.Row="10" Value="{Binding RetryOnError, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="255"/>
            </Grid>
        </ScrollViewer>

        <controls:OkCancelButtons
            Grid.Row="1"
            Margin="0,5,0,0"
            OkClick="OnOkClick"
            CancelClick="OnCancelClick"/>
    </Grid>
</UserControl>
