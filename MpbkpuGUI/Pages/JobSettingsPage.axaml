<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:MpbkpuGUI.Models"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MpbkpuGUI.Pages.JobSettingsPage">

    <Design.DataContext>
        <models:JobSettingsPageModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:IsBackupJobConverter x:Key="IsBackupJobConverter"/>
    </UserControl.Resources>

    <Grid Margin="5,0,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Label Content="{i18n:Localize Name}" />
                <controls:ErrorContainer Name="NameError" Grid.Row="1" FieldName="Name"
                                         Errors="{Binding $parent.DataContext.Errors}">
                    <controls:ErrorContainer.Control>
                        <TextBox Name="Name" Text="{Binding $parent[3].DataContext.Job.Name, Mode=TwoWay}" />
                    </controls:ErrorContainer.Control>
                </controls:ErrorContainer>

                <Label Grid.Row="2" Content="{i18n:Localize Type}" Margin="0,5,0,0"
                       IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}"/>
                <ComboBox Grid.Row="3" Name="CmbType"
                          IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}"
                          SelectedItem="{Binding Job.Type, Mode=TwoWay}"/>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="{i18n:Localize Source}" Margin="0,5,5,0" />
                    <Border Grid.Row="1" Grid.Column="0"
                            Margin="0,0,5,0"
                            CornerRadius="10" ClipToBounds="True"
                            Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                            BorderBrush="{DynamicResource SystemControlBackgroundBaseHighBrush}"
                            BorderThickness="0.5"
                            Padding="15">
                        <controls:PositionDetail
                            Name="Source" />
                    </Border>

                    <Label Grid.Row="0" Grid.Column="1" Content="{i18n:Localize Destination}" Margin="5,5,0,0" />
                    <Border Grid.Row="1" Grid.Column="1"
                            Margin="5,0,0,0"
                            CornerRadius="10" ClipToBounds="True"
                            Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                            BorderBrush="{DynamicResource SystemControlBackgroundBaseHighBrush}"
                            BorderThickness="0.5"
                            Padding="15">
                        <controls:PositionDetail
                            Name="Destination" />
                    </Border>
                </Grid>

                <Label Grid.Row="5" Content="{i18n:Localize CompressionLevel}" Margin="0,5,0,0"
                       IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}"/>
                <ComboBox Grid.Row="6" Name="CmbCompressionLevel"
                          IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}"
                          SelectedItem="{Binding Job.CompressionLevel, Mode=TwoWay}"/>

                <Label Grid.Row="7" Content="{i18n:Localize Encrypted}"
                       IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}"
                       Margin="0,5,0,0" />
                <CheckBox Grid.Row="8"
                          IsEnabled="{Binding IsNew}"
                          IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}"
                          IsChecked="{Binding Job.Encrypted, Mode=TwoWay}"></CheckBox>

                <Label Grid.Row="9" Content="{i18n:Localize HashCheck}" Margin="0,5,0,0" />
                <CheckBox Grid.Row="10" IsChecked="{Binding !Job.SkipHashCheck, Mode=TwoWay}"></CheckBox>

                <Label Grid.Row="11" Content="{i18n:Localize RetryOnError}" Margin="0,5,0,0" />
                <NumericUpDown Grid.Row="12" Value="{Binding Job.RetryOnError, Mode=TwoWay}"
                               Minimum="1"
                               Maximum="255"/>

                <Label Grid.Row="13" Content="{i18n:Localize FullBackupEveryDays}" Margin="0,5,0,0"
                       IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}"/>
                <NumericUpDown Grid.Row="14" Value="{Binding Job.FullBackupEveryDays, Mode=TwoWay}"
                               IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}"
                               Minimum="0"
                               Maximum="3650"/>

                <Label Grid.Row="15" Content="{i18n:Localize KeepChains}" Margin="0,5,0,0"
                       IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}"/>
                <NumericUpDown Grid.Row="16" Value="{Binding Job.KeepChains, Mode=TwoWay}"
                               IsVisible="{Binding Job, Converter={StaticResource IsBackupJobConverter}}"
                               Minimum="0"
                               Maximum="1000"/>
            </Grid>
        </ScrollViewer>

        <controls:OkCancelButtons
            Grid.Row="1"
            Margin="0,5,0,0"
            OkClick="OnOkClick"
            CancelClick="OnCancelClick"/>
    </Grid>
</UserControl>
