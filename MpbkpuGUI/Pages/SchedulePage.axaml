<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="740"
             x:Class="MpbkpuGUI.Pages.SchedulePage">
    <UserControl.Resources>
        <converters:EnumToLocalizedStringConverter x:Key="EnumToLocalizedStringConverter"/>
        <converters:BackupResultToColorConverter x:Key="BackupResultToColorConverter"/>
    </UserControl.Resources>

    <!-- The scheduled jobs with the result of their last run -->
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
            <StackPanel Margin="40,32,40,48" MaxWidth="1040" Spacing="24">
                <StackPanel Spacing="6">
                    <TextBlock Classes="h1" Text="{i18n:Localize Scheduled}" />
                    <TextBlock Classes="subtitle" Text="{i18n:Localize ScheduledSubtitle}" />
                </StackPanel>

                <Border Name="EmptyState" Classes="card" IsVisible="False" Padding="32">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <mi:MaterialIcon Kind="CalendarClock" Width="32" Height="32" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Classes="subtitle" TextWrapping="Wrap" TextAlignment="Center" Text="{i18n:Localize NoScheduledJobs}" />
                    </StackPanel>
                </Border>

                <ItemsControl Name="List">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="title" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <Border Classes="chip">
                                                <TextBlock Text="{Binding TypeText}" />
                                            </Border>
                                            <Border Classes="chip">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <mi:MaterialIcon Kind="ClockOutline" Width="12" Height="12" Foreground="{DynamicResource SubtleTextBrush}" />
                                                    <TextBlock Text="{Binding ScheduleText}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Classes="muted" Text="{Binding NextRunText}" />
                                        <StackPanel Orientation="Horizontal" Spacing="16">
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding LastResult, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                         Fill="{Binding LastResult, Converter={StaticResource BackupResultToColorConverter}}" />
                                                <TextBlock FontSize="13" VerticalAlignment="Center"
                                                           Foreground="{Binding LastResult, Converter={StaticResource BackupResultToColorConverter}}"
                                                           Text="{Binding LastResult, Converter={StaticResource EnumToLocalizedStringConverter}, ConverterParameter=Result_}" />
                                            </StackPanel>
                                            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding LastRunText}" />
                                        </StackPanel>
                                        <TextBlock IsVisible="{Binding HasError}" TextWrapping="Wrap" FontSize="13"
                                                   Foreground="{DynamicResource DangerBrush}" Text="{Binding ErrorText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="20,0,0,0">
                                        <Button Classes="icon" Click="OnOpenLogClick" IsVisible="{Binding HasLog}"
                                                ToolTip.Tip="{i18n:Localize OpenLog}" AutomationProperties.Name="{i18n:Localize OpenLog}">
                                            <mi:MaterialIcon Kind="TextBoxOutline" />
                                        </Button>
                                        <Button Classes="icon" Click="OnSettingsClick"
                                                ToolTip.Tip="{i18n:Localize Settings}" AutomationProperties.Name="{i18n:Localize Settings}">
                                            <mi:MaterialIcon Kind="CogOutline" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="40,14">
            <controls:OkCancelButtons CancelVisible="False"
                                      OkText="{i18n:Localize Close}"
                                      OkClick="OnCloseClick"/>
        </Border>
    </Grid>
</UserControl>
