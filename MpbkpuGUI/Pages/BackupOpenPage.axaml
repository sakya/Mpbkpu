<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             xmlns:models="clr-namespace:MpbkpuGUI.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MpbkpuGUI.Pages.BackupOpenPage">

    <Design.DataContext>
        <models:BackupOpenPageModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:BytesToStringConverter x:Key="BytesToStringConverter"/>
        <converters:DateTimeConverter x:Key="DateTimeConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ListBox Items="{Binding Backups}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="Main" Text="{Binding Backup.StartedAt, Converter={StaticResource DateTimeConverter}, FallbackValue=null}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="Secondary" Text="{Binding Backup.Type, FallbackValue=null}" />

                        <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Classes="Main" Text="{Binding Size, Converter={StaticResource BytesToStringConverter}}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Click="OnOpenClick">
                                <i:Icon Value="fas fa-folder-open"></i:Icon>
                            </Button>
                            <Button Click="OnVerifyClick">
                                <i:Icon Value="fas fa-check-circle"></i:Icon>
                            </Button>
                            <Button Click="OnDeleteClick">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="DarkRed"/>
                                    </Style>
                                </Button.Styles>
                                <i:Icon Value="fas fa-trash"></i:Icon>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <controls:Spinner Grid.Row="0" Name="Spinner"
                          Message="{Binding $parent.DataContext.SpinnerMessage}"/>
    </Grid>
</UserControl>
