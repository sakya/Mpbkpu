<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             xmlns:models="clr-namespace:MpbkpuGUI.Models"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MpbkpuGUI.Pages.BackupOpenPage">

    <Design.DataContext>
        <models:BackupOpenPageModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:BytesToStringConverter x:Key="BytesToStringConverter"/>
        <converters:DateTimeConverter x:Key="DateTimeConverter"/>
        <converters:BackupResultToIconConverter x:Key="BackupResultToIconConverter" />
        <converters:BackupResultToColorConverter x:Key="BackupResultToColorConverter" />
    </UserControl.Resources>

    <Grid Margin="5,0,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ItemsList
            Items="{Binding Backups}">
            <controls:ItemsList.ItemTemplate>
                <DataTemplate>
                    <Border Padding="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <i:Icon Value="{Binding Backup.Result, Converter={StaticResource BackupResultToIconConverter}}"
                                    Foreground="{Binding Backup.Result, Converter={StaticResource BackupResultToColorConverter}}"
                                    Grid.RowSpan="2"
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Margin="0,0,15,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="Main" Text="{Binding Backup.StartedAt, Converter={StaticResource DateTimeConverter}, FallbackValue=null}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="Secondary" Text="{Binding Backup.Type, FallbackValue=null}" />

                            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Classes="Main" Text="{Binding Size, Converter={StaticResource BytesToStringConverter}}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button Click="OnOpenClick" ToolTip.Tip="{i18n:Localize BrowseBackup}">
                                    <i:Icon Value="fas fa-folder-open"></i:Icon>
                                </Button>
                                <Button Click="OnVerifyClick" ToolTip.Tip="{i18n:Localize VerifyBackup}">
                                    <i:Icon Value="fas fa-check-circle"></i:Icon>
                                </Button>
                                <Button Click="OnDeleteClick" ToolTip.Tip="{i18n:Localize DeleteBackup}">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                            <Setter Property="Background" Value="DarkRed"/>
                                        </Style>
                                    </Button.Styles>
                                    <i:Icon Value="fas fa-trash"></i:Icon>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </controls:ItemsList.ItemTemplate>
        </controls:ItemsList>

        <controls:OkCancelButtons Grid.Row="1"
                                  CancelVisible="False"
                                  OkText="{i18n:Localize Close}"
                                  OkClick="OnOkClick"/>
        <controls:Spinner Grid.Row="0" Grid.RowSpan="2" Name="Spinner"
                          Message="{Binding $parent.DataContext.SpinnerMessage}"/>
    </Grid>
</UserControl>
