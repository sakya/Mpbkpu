<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             xmlns:models="clr-namespace:MpbkpuGUI.Models"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="740"
             x:Class="MpbkpuGUI.Pages.BackupOpenPage">

    <Design.DataContext>
        <models:BackupOpenPageModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:BytesToStringConverter x:Key="BytesToStringConverter"/>
        <converters:DateTimeConverter x:Key="DateTimeConverter"/>
        <converters:BackupResultToIconConverter x:Key="BackupResultToIconConverter" />
        <converters:BackupResultToColorConverter x:Key="BackupResultToColorConverter" />
        <converters:EnumToLocalizedStringConverter x:Key="EnumToLocalizedStringConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel Margin="40,28,40,40" MaxWidth="1120" Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Name="Title" Classes="h1" />
                    <TextBlock Name="Paths" Classes="mono" />
                </StackPanel>

                <Border Classes="card" Padding="32"
                        IsVisible="{Binding !Backups.Count, FallbackValue=False}">
                    <TextBlock Classes="subtitle" HorizontalAlignment="Center" Text="{i18n:Localize NoBackups}" />
                </Border>

                <ItemsControl ItemsSource="{Binding Backups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="8">
                                <StackPanel Spacing="2" Margin="4,16,0,4"
                                            IsVisible="{Binding ChainTitle, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <TextBlock Classes="h2" Text="{Binding ChainTitle}" />
                                    <TextBlock Classes="muted" Text="{Binding ChainSummary}" />
                                </StackPanel>

                                <Border Classes="card hoverable" Padding="16,12">
                                    <StackPanel Spacing="12">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                            <mi:MaterialIcon Width="22" Height="22" Margin="4,0,16,0" VerticalAlignment="Center"
                                                             Kind="{Binding Backup.Result, Converter={StaticResource BackupResultToIconConverter}}"
                                                             Foreground="{Binding Backup.Result, Converter={StaticResource BackupResultToColorConverter}}" />
                                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Classes="Main" Text="{Binding Backup.StartedAt, Converter={StaticResource DateTimeConverter}, FallbackValue=''}" />
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Classes="chip">
                                                        <TextBlock Text="{Binding Backup.Type, Converter={StaticResource EnumToLocalizedStringConverter}, ConverterParameter=BackupType_}" />
                                                    </Border>
                                                    <TextBlock Classes="muted" VerticalAlignment="Center"
                                                               Foreground="{Binding Backup.Result, Converter={StaticResource BackupResultToColorConverter}}"
                                                               Text="{Binding Backup.Result, Converter={StaticResource EnumToLocalizedStringConverter}, ConverterParameter=Result_}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center" Margin="16,0" TextAlignment="Right"
                                                       Text="{Binding ItemsText}" />
                                            <TextBlock Grid.Column="3" Classes="Main" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right"
                                                       Text="{Binding Size, Converter={StaticResource BytesToStringConverter}}" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" Margin="20,0,0,0">
                                                <Button Classes="icon" Click="OnOpenClick" ToolTip.Tip="{i18n:Localize BrowseBackup}" AutomationProperties.Name="{i18n:Localize BrowseBackup}">
                                                    <mi:MaterialIcon Kind="FolderOpenOutline" />
                                                </Button>
                                                <Button Classes="icon" Click="OnRestoreClick" ToolTip.Tip="{i18n:Localize RestoreBackup}" AutomationProperties.Name="{i18n:Localize RestoreBackup}">
                                                    <mi:MaterialIcon Kind="BackupRestore" />
                                                </Button>
                                                <Button Classes="icon" Click="OnVerifyClick" ToolTip.Tip="{i18n:Localize VerifyBackup}" AutomationProperties.Name="{i18n:Localize VerifyBackup}">
                                                    <mi:MaterialIcon Kind="ShieldCheckOutline" />
                                                </Button>
                                                <Button Classes="icon dangerHover" Click="OnDeleteClick" ToolTip.Tip="{i18n:Localize DeleteBackup}" AutomationProperties.Name="{i18n:Localize DeleteBackup}">
                                                    <mi:MaterialIcon Kind="DeleteOutline" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <Border Classes="warningBox" IsVisible="{Binding HasWarnings}">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <mi:MaterialIcon Kind="AlertOutline" Width="16" Height="16" Foreground="{DynamicResource WarningBrush}" />
                                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource WarningTitleBrush}" Text="{i18n:Localize WarningsTitle}" />
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Warnings}" Margin="24,0,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock FontSize="13" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,2" Text="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <controls:Spinner Name="Spinner"
                          Message="{Binding $parent.DataContext.SpinnerMessage}"/>
    </Grid>
</UserControl>
