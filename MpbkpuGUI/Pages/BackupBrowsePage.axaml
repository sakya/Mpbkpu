<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             xmlns:models="clr-namespace:MpbkpuGUI.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MpbkpuGUI.Pages.BackupBrowsePage">
    <Design.DataContext>
        <models:BackupBrowseModel />
    </Design.DataContext>

    <UserControl.Resources>
        <converters:BytesToStringConverter x:Key="BytesToStringConverter"/>
        <converters:DateTimeConverter x:Key="DateTimeConverter"/>
    </UserControl.Resources>

    <Grid Margin="5,0,5,5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="100" />
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*" MinWidth="100" />
        </Grid.ColumnDefinitions>

        <TreeView Name="TreeView" Items="{Binding Directories}"
                  SelectionChanged="OnTreeSelectionChanged">
            <TreeView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel MaxWidth="{Binding #TreeView.Bounds.Width}" />
                </ItemsPanelTemplate>
            </TreeView.ItemsPanel>
            <TreeView.DataTemplates>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </TreeDataTemplate>
            </TreeView.DataTemplates>
        </TreeView>

        <GridSplitter Grid.Row="0" Grid.Column="1" KeyboardNavigation.IsTabStop="False"/>

        <controls:ItemsList Grid.Row="0" Grid.Column="2"
                            Grid.IsSharedSizeScope="True"
                            Selectable="True"
                            Items="{Binding Files}">
            <controls:ItemsList.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,5,10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="30" />
                                <ColumnDefinition SharedSizeGroup="ColModified" Width="Auto" />
                                <ColumnDefinition SharedSizeGroup="ColSize" Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding OriginalName}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding OriginalLastModified, Converter={StaticResource DateTimeConverter}}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="5,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Size, Converter={StaticResource BytesToStringConverter}}"
                                       TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </controls:ItemsList.ItemTemplate>
        </controls:ItemsList>

        <controls:OkCancelButtons
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,5,0,0"
            OkText="{Binding $parent.DataContext.ButtonText}"
            CancelVisible="False"
            OkClick="OnOkClick"/>
        <controls:Spinner Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="2" Name="Spinner"
                          Message="{Binding $parent.DataContext.SpinnerMessage}"/>
    </Grid>
</UserControl>
