<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             xmlns:models="clr-namespace:MpbkpuGUI.Models"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="740"
             x:Class="MpbkpuGUI.Pages.JobRunningPage">

    <Design.DataContext>
        <models:JobRunningPageModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="40,28,40,24" MaxWidth="1120">
            <StackPanel Spacing="6">
                <TextBlock Name="JobName" Classes="h1" />
                <TextBlock Classes="mono">
                    <Run Text="{Binding Source}" /><Run Text="  →  " /><Run Text="{Binding Destination}" />
                </TextBlock>
            </StackPanel>

            <Border Grid.Row="1" Classes="card" Margin="0,24,0,0">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <TextBlock FontSize="44" FontWeight="Bold" LetterSpacing="-1"
                                       Text="{Binding Progress, StringFormat='{}{0:0}%'}" />
                            <TextBlock FontSize="15" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Bottom"
                                       Margin="0,0,0,10" Text="{Binding Step}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" />
                    <Grid ColumnDefinitions="*,12,*,12,*">
                        <Border Classes="tile">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="muted" FontSize="12" Text="{i18n:Localize Files}" />
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ProgressMessageFiles, FallbackValue='–', TargetNullValue='–'}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="tile">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="muted" FontSize="12" Text="{i18n:Localize Data}" />
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ProgressMessageBytes, FallbackValue='–', TargetNullValue='–'}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Classes="tile">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="muted" FontSize="12" Text="{i18n:Localize TimeLeft}" />
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding ProgressMessageEta, FallbackValue='–', TargetNullValue='–'}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Spacing="8" IsVisible="{Binding HasCopyingFiles}">
                        <TextBlock Classes="muted" FontSize="12" Text="{i18n:Localize FilesBeingCopied}" />
                        <ItemsControl ItemsSource="{Binding CopyingFiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,12,160,12,44">
                                        <TextBlock Classes="mono" FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="LeadingCharacterEllipsis" Text="{Binding Path}"
                                                   ToolTip.Tip="{Binding Path}" />
                                        <ProgressBar Grid.Column="2" Classes="inline" Minimum="0" Maximum="100"
                                                     VerticalAlignment="Center" Value="{Binding Progress}" />
                                        <TextBlock Grid.Column="4" Classes="muted" FontSize="12" TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Progress, StringFormat='{}{0:0}%'}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- Space of the destination: read at the start and at the end, estimated during the job -->
                    <!-- One row per destination, shown when its space is known -->
                    <StackPanel Name="SpaceList" Spacing="10" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="card" Margin="0,20,0,0" Padding="20">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Classes="h2" Text="{i18n:Localize Log}" />
                    <ScrollViewer Name="Log" Grid.Row="1" Margin="0,12,0,0">
                        <ListBox Classes="log" ItemsSource="{Binding Log}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Button Grid.Row="3" Margin="0,20,0,0" HorizontalAlignment="Right" MinWidth="160"
                    Classes.danger="{Binding Running}" Classes.accent="{Binding !Running}"
                    Content="{Binding ButtonText}" Click="OnOkClick" />
        </Grid>
        <controls:Spinner Name="Spinner" />
    </Grid>
</UserControl>
