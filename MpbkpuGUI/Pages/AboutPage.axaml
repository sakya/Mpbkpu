<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:models="clr-namespace:MpbkpuGUI.Models"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="740"
             x:Class="MpbkpuGUI.Pages.AboutPage">
    <Design.DataContext>
        <models:AboutPageModel />
    </Design.DataContext>

    <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
            <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="40" Padding="40" MaxWidth="560">
                <StackPanel Spacing="10">
                    <Image Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,10"
                           Source="avares://mpbkpugui/Assets/icon.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" Text="{Binding Title}" />
                    <TextBlock Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" Text="{Binding Copyright}" />
                    <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"
                               Foreground="{DynamicResource SubtleTextBrush}" Text="{Binding Description}" />

                    <!-- Updates: releases published on GitHub -->
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20,0,10" />
                    <TextBlock Classes="h2" HorizontalAlignment="Center" Text="{i18n:Localize Updates}" />
                    <TextBlock HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Text="{Binding UpdateStatus}" />
                    <ProgressBar IsVisible="{Binding IsDownloading}" Value="{Binding DownloadProgress}" Maximum="100" />
                    <WrapPanel HorizontalAlignment="Center" ItemSpacing="10" LineSpacing="10">
                        <Button Click="OnCheckUpdatesClick" IsEnabled="{Binding !IsBusy}"
                                AutomationProperties.Name="{i18n:Localize CheckUpdates}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                                <TextBlock Text="{i18n:Localize CheckUpdates}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnReleasePageClick" IsVisible="{Binding UpdateFound}"
                                AutomationProperties.Name="{i18n:Localize ReleasePage}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="OpenInNew" Width="16" Height="16" />
                                <TextBlock Text="{i18n:Localize ReleasePage}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="accent" Click="OnInstallUpdateClick" IsVisible="{Binding CanInstall}"
                                IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="{i18n:Localize InstallUpdate}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="Download" Width="16" Height="16" />
                                <TextBlock Text="{i18n:Localize InstallUpdate}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <ToggleSwitch Name="CheckAtStartup" HorizontalAlignment="Center" Margin="0,6,0,0"
                                  OnContent="{i18n:Localize CheckUpdatesAtStartup}" OffContent="{i18n:Localize CheckUpdatesAtStartup}"
                                  AutomationProperties.Name="{i18n:Localize CheckUpdatesAtStartup}"
                                  IsCheckedChanged="OnCheckAtStartupChanged" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="40,14">
            <controls:OkCancelButtons CancelVisible="False"
                                      OkText="{i18n:Localize Close}"
                                      OkClick="OnOkClick"/>
        </Border>
    </Grid>
</UserControl>
