<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="740"
             x:Class="MpbkpuGUI.Pages.SettingsPage">
    <UserControl.Resources>
        <converters:EnumToLocalizedStringConverter x:Key="EnumToLocalizedStringConverter"/>
    </UserControl.Resources>

    <!-- Settings of the app: every change is applied and saved at once -->
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
            <StackPanel Margin="40,32,40,48" MaxWidth="720" Spacing="24" HorizontalAlignment="Stretch">
                <TextBlock Classes="h1" Text="{i18n:Localize Settings}" />

                <Border Classes="card">
                    <StackPanel Spacing="16">
                        <TextBlock Classes="h2" Text="{i18n:Localize Appearance}" />
                        <StackPanel Spacing="4">
                            <Label Content="{i18n:Localize Theme}" />
                            <ComboBox Name="CmbTheme" Width="280" HorizontalAlignment="Left" SelectionChanged="OnThemeChanged"
                                      AutomationProperties.Name="{i18n:Localize Theme}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}, ConverterParameter=Theme_}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Label Content="{i18n:Localize Accent}" />
                            <ComboBox Name="CmbAccent" Width="280" HorizontalAlignment="Left" SelectionChanged="OnAccentChanged"
                                      AutomationProperties.Name="{i18n:Localize Accent}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}, ConverterParameter=Accent_}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Classes="hint" Text="{i18n:Localize AccentHint}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="{i18n:Localize Updates}" />
                        <ToggleSwitch Name="CheckAtStartup" IsCheckedChanged="OnCheckAtStartupChanged"
                                      OnContent="{i18n:Localize CheckUpdatesAtStartup}" OffContent="{i18n:Localize CheckUpdatesAtStartup}"
                                      AutomationProperties.Name="{i18n:Localize CheckUpdatesAtStartup}" />
                        <TextBlock Classes="hint" Margin="0" Text="{i18n:Localize CheckUpdatesHint}" />

                        <!-- Releases published on GitHub (Utility/UpdateChecker) -->
                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"
                                   IsVisible="{Binding UpdateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding UpdateStatus}" />
                        <ProgressBar IsVisible="{Binding IsDownloading}" Value="{Binding DownloadProgress}" Maximum="100" />
                        <WrapPanel ItemSpacing="10" LineSpacing="10">
                            <Button Click="OnCheckUpdatesClick" IsEnabled="{Binding !IsBusy}"
                                    AutomationProperties.Name="{i18n:Localize CheckUpdates}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                                    <TextBlock Text="{i18n:Localize CheckUpdates}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnReleasePageClick" IsVisible="{Binding UpdateFound}"
                                    AutomationProperties.Name="{i18n:Localize ReleasePage}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="OpenInNew" Width="16" Height="16" />
                                    <TextBlock Text="{i18n:Localize ReleasePage}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="accent" Click="OnInstallUpdateClick" IsVisible="{Binding CanInstall}"
                                    IsEnabled="{Binding !IsBusy}" AutomationProperties.Name="{i18n:Localize InstallUpdate}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="Download" Width="16" Height="16" />
                                    <TextBlock Text="{i18n:Localize InstallUpdate}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Jobs moved to or from another computer (Utility/JobTransfer) -->
                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="{i18n:Localize ExportImportJobs}" />
                        <TextBlock Classes="hint" Margin="0" Text="{i18n:Localize ExportImportJobsHint}" />
                        <WrapPanel ItemSpacing="10" LineSpacing="10">
                            <Button Click="OnExportJobsClick" AutomationProperties.Name="{i18n:Localize ExportJobs}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="FileExportOutline" Width="16" Height="16" />
                                    <TextBlock Text="{i18n:Localize ExportJobs}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnImportJobsClick" AutomationProperties.Name="{i18n:Localize ImportJobs}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <mi:MaterialIcon Kind="FileImportOutline" Width="16" Height="16" />
                                    <TextBlock Text="{i18n:Localize ImportJobs}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource ChromeBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="40,14">
            <controls:OkCancelButtons CancelVisible="False"
                                      OkText="{i18n:Localize Close}"
                                      OkClick="OnCloseClick"/>
        </Border>
    </Grid>
</UserControl>
