<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:models="clr-namespace:MpbkpuGUI.Dialogs.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MpbkpuGUI.Dialogs.PasswordDialog">

    <Design.DataContext>
        <models:PasswordDialogModel />
    </Design.DataContext>

    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="Black"
                    TintOpacity="1"
                    MaterialOpacity="0.65" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Label Content="{i18n:Localize Password}" />
            <controls:ErrorContainer Name="NameError" Grid.Row="1"
                                     FieldName="Password"
                                     Errors="{Binding $parent.DataContext.Errors}">
                <controls:ErrorContainer.Control>
                    <TextBox Name="Password" PasswordChar="●" MinWidth="300"
                             Text="{Binding $parent[3].DataContext.Password}"/>
                </controls:ErrorContainer.Control>
            </controls:ErrorContainer>

            <controls:OkCancelButtons
                Grid.Row="2"
                Margin="0,15,0,0"
                SmallButtons="True"
                OkClick="OnOkClick"
                CancelClick="OnCancelClick"/>
        </Grid>
    </Panel>
</UserControl>
