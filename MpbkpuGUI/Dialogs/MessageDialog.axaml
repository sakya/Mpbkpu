<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             xmlns:models="clr-namespace:MpbkpuGUI.Dialogs.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MpbkpuGUI.Dialogs.MessageDialog">

    <Design.DataContext>
        <models:MessageDialogModel />
    </Design.DataContext>

    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="Black"
                    TintOpacity="1"
                    MaterialOpacity="0.65" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <i:Icon
                    Margin="0,2,5,0"
                    VerticalAlignment="Top"
                    IsVisible="{Binding IconVisible}"
                    Foreground="{Binding IconBrush}"
                    Value="{Binding Icon}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left" />
            </Grid>

            <Button Grid.Row="1"
                    Grid.Column="{Binding Button2Data.Column}"
                    Grid.ColumnSpan="{Binding Button2Data.ColumnSpan}"
                    Classes="Small"
                    Click="OnButton2Click"
                    Content="{Binding Button2Data.Text}"
                    IsVisible="{Binding Button2Data.IsVisible}"
                    IsDefault="{Binding Button2Data.IsDefault}"
                    IsCancel="{Binding Button2Data.IsCancel}"
                    Margin="0,15,2.5,0" />
            <Button Grid.Row="1"
                    Grid.Column="{Binding Button1Data.Column}"
                    Grid.ColumnSpan="{Binding Button1Data.ColumnSpan}"
                    Classes="Small Accent"
                    Click="OnButton1Click"
                    Content="{Binding Button1Data.Text}"
                    IsVisible="{Binding Button1Data.IsVisible}"
                    IsDefault="{Binding Button1Data.IsDefault}"
                    IsCancel="{Binding Button2Data.IsCancel}"
                    Margin="2.5,15,0,0" />
        </Grid>
    </Panel>
</UserControl>
