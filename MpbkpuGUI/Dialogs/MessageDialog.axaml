<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:models="clr-namespace:MpbkpuGUI.Dialogs.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MpbkpuGUI.Dialogs.MessageDialog">

    <Design.DataContext>
        <models:MessageDialogModel />
    </Design.DataContext>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
            CornerRadius="16" Padding="24" MinWidth="380" MaxWidth="560" BoxShadow="0 16 48 0 #99000000">
        <Grid RowDefinitions="*,Auto">
            <Grid ColumnDefinitions="Auto,*">
                <mi:MaterialIcon
                    Width="22" Height="22"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    IsVisible="{Binding IconVisible}"
                    Foreground="{Binding IconBrush}"
                    Kind="{Binding Icon}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left" />
            </Grid>

            <!-- Buttons on the right: the secondary action before the primary one -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,24,0,0">
                <Button Name="SecondaryButton"
                        Classes="Small"
                        MinWidth="110"
                        Click="OnButton2Click"
                        Content="{Binding Button2Data.Text}"
                        IsVisible="{Binding Button2Data.IsVisible}"
                        IsDefault="{Binding Button2Data.IsDefault}"
                        IsCancel="{Binding Button2Data.IsCancel}" />
                <Button Name="PrimaryButton"
                        Classes="Small accent"
                        MinWidth="110"
                        Click="OnButton1Click"
                        Content="{Binding Button1Data.Text}"
                        IsVisible="{Binding Button1Data.IsVisible}"
                        IsDefault="{Binding Button1Data.IsDefault}"
                        IsCancel="{Binding Button1Data.IsCancel}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
