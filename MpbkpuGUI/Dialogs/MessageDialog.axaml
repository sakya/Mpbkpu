<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:models="clr-namespace:MpbkpuGUI.Dialogs.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MpbkpuGUI.Dialogs.MessageDialog">

    <Design.DataContext>
        <models:MessageDialogModel />
    </Design.DataContext>

    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            CornerRadius="16" Padding="24" MinWidth="380" MaxWidth="560" BoxShadow="0 16 48 0 #99000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <mi:MaterialIcon
                    Width="22" Height="22"
                    Margin="0,0,14,0"
                    VerticalAlignment="Top"
                    IsVisible="{Binding IconVisible}"
                    Foreground="{Binding IconBrush}"
                    Kind="{Binding Icon}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left" />
            </Grid>

            <Button Grid.Row="1"
                    Grid.Column="{Binding Button2Data.Column}"
                    Grid.ColumnSpan="{Binding Button2Data.ColumnSpan}"
                    Classes="Small"
                    MinWidth="110"
                    Click="OnButton2Click"
                    Content="{Binding Button2Data.Text}"
                    IsVisible="{Binding Button2Data.IsVisible}"
                    IsDefault="{Binding Button2Data.IsDefault}"
                    IsCancel="{Binding Button2Data.IsCancel}"
                    Margin="0,24,6,0" />
            <Button Grid.Row="1"
                    Grid.Column="{Binding Button1Data.Column}"
                    Grid.ColumnSpan="{Binding Button1Data.ColumnSpan}"
                    Classes="Small accent"
                    MinWidth="110"
                    Click="OnButton1Click"
                    Content="{Binding Button1Data.Text}"
                    IsVisible="{Binding Button1Data.IsVisible}"
                    IsDefault="{Binding Button1Data.IsDefault}"
                    IsCancel="{Binding Button2Data.IsCancel}"
                    Margin="6,24,0,0" />
        </Grid>
    </Border>
</UserControl>
