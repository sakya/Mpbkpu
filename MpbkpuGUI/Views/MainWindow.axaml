<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
        xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
        xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        WindowStartupLocation="CenterScreen"
        x:Class="MpbkpuGUI.Views.MainWindow"
        MinWidth="500"
        MinHeight="200"
        Title="Multi Platform Backup Utility">
    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="Black"
                    TintOpacity="1"
                    MaterialOpacity="0.65" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <DockPanel>
            <controls:TitleBar Name="TitleBar" DockPanel.Dock="Top"/>
            <Grid Name="Container">
                <Grid Name="Spinner" IsVisible="True">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel Name="WaitSpinner" Classes="spinner" VerticalAlignment="Center" HorizontalAlignment="Center" Width="40" Height="40">
                            <i:Icon HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40" FontSize="32" Value="fas fa-circle-notch" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Panel>
</Window>
