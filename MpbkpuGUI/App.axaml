<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="MpbkpuGUI.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
        <!-- Palette: one color set per theme variant (App.ApplyTheme); use the brushes with DynamicResource -->
        <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="BgColor">#0F1115</Color>
                    <Color x:Key="ChromeColor">#0B0D11</Color>
                    <Color x:Key="SurfaceColor">#151820</Color>
                    <Color x:Key="SurfaceAltColor">#11141A</Color>
                    <Color x:Key="LineColor">#232832</Color>
                    <Color x:Key="InputLineColor">#2A303B</Color>
                    <Color x:Key="BorderHoverColor">#3A4250</Color>
                    <Color x:Key="TileLineColor">#1E222A</Color>
                    <Color x:Key="TextColor">#E6E8EB</Color>
                    <Color x:Key="StrongTextColor">#FFFFFF</Color>
                    <Color x:Key="SubtleTextColor">#C3CAD5</Color>
                    <Color x:Key="MutedTextColor">#A8B0BC</Color>
                    <Color x:Key="AccentColor">#2F6FEB</Color>
                    <Color x:Key="AccentTextColor">#8AB4FF</Color>
                    <Color x:Key="AccentSoftColor">#16223A</Color>
                    <Color x:Key="ChipColor">#1E2430</Color>
                    <Color x:Key="HoverColor">#1A1F29</Color>
                    <Color x:Key="ButtonColor">#171A21</Color>
                    <Color x:Key="ButtonHoverColor">#1F2430</Color>
                    <Color x:Key="ButtonPressedColor">#262C38</Color>
                    <Color x:Key="SyncColor">#6EE7B7</Color>
                    <Color x:Key="SyncSoftColor">#1C2A26</Color>
                    <Color x:Key="DebugColor">#8A93A0</Color>
                    <Color x:Key="InfoColor">#8AB4FF</Color>
                    <Color x:Key="SuccessColor">#4ADE80</Color>
                    <Color x:Key="WarningColor">#F5B544</Color>
                    <Color x:Key="WarningSoftColor">#1F1A10</Color>
                    <Color x:Key="WarningLineColor">#3A2F17</Color>
                    <Color x:Key="WarningTitleColor">#F5D48A</Color>
                    <Color x:Key="WarningTextColor">#E8DCC0</Color>
                    <Color x:Key="DangerColor">#FF7B72</Color>
                    <Color x:Key="ErrorColor">#FF7B72</Color>
                    <Color x:Key="DangerSoftColor">#1F1416</Color>
                    <Color x:Key="DangerLineColor">#5A2A2A</Color>
                    <Color x:Key="DangerHoverColor">#2A1719</Color>
                    <Color x:Key="DangerHoverLineColor">#7A3434</Color>
                    <Color x:Key="DangerHoverTextColor">#FFB0AA</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BgColor">#F5F6F8</Color>
                    <Color x:Key="ChromeColor">#ECEEF2</Color>
                    <Color x:Key="SurfaceColor">#FFFFFF</Color>
                    <Color x:Key="SurfaceAltColor">#F7F8FA</Color>
                    <Color x:Key="LineColor">#DDE1E7</Color>
                    <Color x:Key="InputLineColor">#CBD1DA</Color>
                    <Color x:Key="BorderHoverColor">#AEB6C2</Color>
                    <Color x:Key="TileLineColor">#E3E6EB</Color>
                    <Color x:Key="TextColor">#1A1D23</Color>
                    <Color x:Key="StrongTextColor">#000000</Color>
                    <Color x:Key="SubtleTextColor">#3D4450</Color>
                    <Color x:Key="MutedTextColor">#5F6875</Color>
                    <Color x:Key="AccentColor">#2F6FEB</Color>
                    <Color x:Key="AccentTextColor">#1F5BD6</Color>
                    <Color x:Key="AccentSoftColor">#E3ECFD</Color>
                    <Color x:Key="ChipColor">#EEF0F4</Color>
                    <Color x:Key="HoverColor">#E9ECF1</Color>
                    <Color x:Key="ButtonColor">#FFFFFF</Color>
                    <Color x:Key="ButtonHoverColor">#F0F2F5</Color>
                    <Color x:Key="ButtonPressedColor">#E6E9EE</Color>
                    <Color x:Key="SyncColor">#0F9F6E</Color>
                    <Color x:Key="SyncSoftColor">#E3F6EE</Color>
                    <Color x:Key="DebugColor">#6B7380</Color>
                    <Color x:Key="InfoColor">#1F5BD6</Color>
                    <Color x:Key="SuccessColor">#16A34A</Color>
                    <Color x:Key="WarningColor">#B7791F</Color>
                    <Color x:Key="WarningSoftColor">#FFF7E6</Color>
                    <Color x:Key="WarningLineColor">#F2D49B</Color>
                    <Color x:Key="WarningTitleColor">#8A5A00</Color>
                    <Color x:Key="WarningTextColor">#5C4A1F</Color>
                    <Color x:Key="DangerColor">#D93A31</Color>
                    <Color x:Key="ErrorColor">#D93A31</Color>
                    <Color x:Key="DangerSoftColor">#FDECEB</Color>
                    <Color x:Key="DangerLineColor">#F2B8B4</Color>
                    <Color x:Key="DangerHoverColor">#FBE3E1</Color>
                    <Color x:Key="DangerHoverLineColor">#E89A94</Color>
                    <Color x:Key="DangerHoverTextColor">#B42318</Color>
                </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}" />
        <SolidColorBrush x:Key="ChromeBrush" Color="{DynamicResource ChromeColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="{DynamicResource SurfaceAltColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{DynamicResource LineColor}" />
        <SolidColorBrush x:Key="InputLineBrush" Color="{DynamicResource InputLineColor}" />
        <SolidColorBrush x:Key="BorderHoverBrush" Color="{DynamicResource BorderHoverColor}" />
        <SolidColorBrush x:Key="TileLineBrush" Color="{DynamicResource TileLineColor}" />
        <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
        <SolidColorBrush x:Key="StrongTextBrush" Color="{DynamicResource StrongTextColor}" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="{DynamicResource SubtleTextColor}" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="AccentTextBrush" Color="{DynamicResource AccentTextColor}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
        <SolidColorBrush x:Key="ChipBrush" Color="{DynamicResource ChipColor}" />
        <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
        <SolidColorBrush x:Key="SyncBrush" Color="{DynamicResource SyncColor}" />
        <SolidColorBrush x:Key="SyncSoftBrush" Color="{DynamicResource SyncSoftColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
        <SolidColorBrush x:Key="WarningSoftBrush" Color="{DynamicResource WarningSoftColor}" />
        <SolidColorBrush x:Key="WarningLineBrush" Color="{DynamicResource WarningLineColor}" />
        <SolidColorBrush x:Key="WarningTitleBrush" Color="{DynamicResource WarningTitleColor}" />
        <SolidColorBrush x:Key="WarningTextBrush" Color="{DynamicResource WarningTextColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
        <SolidColorBrush x:Key="DangerSoftBrush" Color="{DynamicResource DangerSoftColor}" />
        <SolidColorBrush x:Key="DangerLineBrush" Color="{DynamicResource DangerLineColor}" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="{DynamicResource DangerHoverColor}" />
        <SolidColorBrush x:Key="DangerHoverLineBrush" Color="{DynamicResource DangerHoverLineColor}" />
        <SolidColorBrush x:Key="DangerHoverTextBrush" Color="{DynamicResource DangerHoverTextColor}" />

        <FontFamily x:Key="AppFont">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>
        <FontWeight x:Key="FontWeight">Normal</FontWeight>
        <x:Double x:Key="FontSize">14</x:Double>

        <!-- Fluent theme overrides -->
        <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
        <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
        <SolidColorBrush x:Key="ButtonBackground" Color="{DynamicResource ButtonColor}" />
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource ButtonHoverColor}" />
        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{DynamicResource ButtonPressedColor}" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="{DynamicResource InputLineColor}" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{DynamicResource BorderHoverColor}" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{DynamicResource BorderHoverColor}" />
        <SolidColorBrush x:Key="ButtonForeground" Color="{DynamicResource TextColor}" />
        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{DynamicResource StrongTextColor}" />
        <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#3D7BF0" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#2860CF" />
        <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextControlBackground" Color="{DynamicResource BgColor}" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{DynamicResource BgColor}" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{DynamicResource BgColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="{DynamicResource InputLineColor}" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{DynamicResource BorderHoverColor}" />
        <SolidColorBrush x:Key="ComboBoxBackground" Color="{DynamicResource BgColor}" />
        <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{DynamicResource HoverColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{DynamicResource InputLineColor}" />
        <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="{DynamicResource BorderHoverColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{DynamicResource SurfaceColor}" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{DynamicResource LineColor}" />
        <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{DynamicResource HoverColor}" />
        <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="{DynamicResource HoverColor}" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderHeaderBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#2F6FEB" RegionColor="#0F1115" />
                <ColorPaletteResources x:Key="Light" Accent="#2F6FEB" RegionColor="#F5F6F8" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <mi:MaterialIconStyles />

        <Style Selector="mi|MaterialIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>

        <Style Selector="StackPanel.spinner">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Base typography -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="{StaticResource FontSize}" />
            <Setter Property="FontWeight" Value="{StaticResource FontWeight}" />
            <Setter Property="Background" Value="{DynamicResource BgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style Selector="TemplatedControl">
            <Setter Property="FontSize" Value="{StaticResource FontSize}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="-0.5" />
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style Selector="TextBlock.Main">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="TextBlock.Secondary">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="Padding" Value="0,0,0,6" />
        </Style>

        <!-- Surfaces -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style Selector="Border.card.hoverable">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card.hoverable:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}" />
        </Style>
        <Style Selector="Border.tile">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TileLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource ChipBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        </Style>
        <Style Selector="Border.iconTile">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.iconTile > mi|MaterialIcon">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="Border.warningBox">
            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <!-- Buttons -->
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.icon.small">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerLineBrush}" />
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerHoverLineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerHoverTextBrush}" />
        </Style>
        <Style Selector="Button.dangerHover:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerHoverLineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerHoverTextBrush}" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource StrongTextBrush}" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- Inputs -->
        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBox.Error">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="TextBox.Error:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- Switches instead of check boxes: the label is the On/Off content, beside the switch -->
        <Style Selector="ToggleSwitch">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Height" Value="10" />
            <Setter Property="MinHeight" Value="10" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="{DynamicResource LineBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- Thin bar for inline information (e.g. space of the destination) -->
        <Style Selector="ProgressBar.inline">
            <Setter Property="Height" Value="6" />
            <Setter Property="MinHeight" Value="6" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="ProgressBar.warning">
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
        </Style>
        <Style Selector="ProgressBar.danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>

        <!-- Log lists -->
        <Style Selector="ListBox.log">
            <Setter Property="Background" Value="{DynamicResource ChromeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TileLineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="ListBox.log ListBoxItem">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="{DynamicResource LineBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">

                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
    </Application.Styles>
</Application>
