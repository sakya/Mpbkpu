<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             xmlns:models="clr-namespace:MpbkpuGUI.Controls.Models"
             xmlns:controls="clr-namespace:MpbkpuGUI.Controls"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MpbkpuGUI.Controls.PositionDetail">
    <Design.DataContext>
        <models:PositionDetailModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:EnumToLocalizedStringConverter x:Key="EnumToLocalizedStringConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Label Grid.Row="0" Content="{i18n:Localize Type}" />
        <ComboBox Grid.Row="1" Name="CmbType" SelectionChanged="OnTypeChanged"
                  SelectedItem="{Binding Type}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumToLocalizedStringConverter}, ConverterParameter=Fs_}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Label Grid.Row="2" Content="{i18n:Localize Path}" Margin="0,12,0,0" />
        <StackPanel Grid.Row="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:ErrorContainer FieldName="Path"
                                     Errors="{Binding $parent.DataContext.Errors}">
                <controls:ErrorContainer.Control>
                    <TextBox  Text="{Binding $parent[3].DataContext.Path, Mode=TwoWay}" />
                </controls:ErrorContainer.Control>
            </controls:ErrorContainer>
            <Button Grid.Column="1"
                    IsVisible="{Binding IsLocalFileSystem}"
                    VerticalAlignment="Top"
                    Click="OnBrowseClick"
                    Classes="icon"
                    Margin="8,0,0,0"
                    ToolTip.Tip="{i18n:Localize BrowseFolder}" AutomationProperties.Name="{i18n:Localize BrowseFolder}">
                <mi:MaterialIcon Kind="FolderOpen"></mi:MaterialIcon>
            </Button>
        </Grid>
        <TextBlock Classes="hint" Text="{Binding PathHint}"
                   IsVisible="{Binding PathHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <Label Grid.Row="4" Content="{i18n:Localize UserName}" Margin="0,12,0,0"
               IsVisible="{Binding SupportUser}"/>
        <controls:ErrorContainer Grid.Row="5" FieldName="User"
                                 Errors="{Binding $parent.DataContext.Errors}">
            <controls:ErrorContainer.Control>
                <TextBox Text="{Binding $parent[3].DataContext.User, Mode=TwoWay}"
                         IsVisible="{Binding $parent[3].DataContext.SupportUser}"/>
            </controls:ErrorContainer.Control>
        </controls:ErrorContainer>

        <Label Grid.Row="6" Content="{i18n:Localize Password}" Margin="0,12,0,0"
               IsVisible="{Binding SupportPassword}"/>
        <controls:ErrorContainer Grid.Row="7" FieldName="Password"
                                 Errors="{Binding $parent.DataContext.Errors}">
            <controls:ErrorContainer.Control>
                <TextBox PasswordChar="●" Text="{Binding $parent[3].DataContext.Password, Mode=TwoWay}"
                         IsVisible="{Binding $parent[3].DataContext.SupportPassword}"/>
            </controls:ErrorContainer.Control>
        </controls:ErrorContainer>

        <Label Grid.Row="8" Content="{i18n:Localize OauthServerUrl}" Margin="0,12,0,0"
               IsVisible="{Binding SupportOAuthServerUrl}"/>
        <controls:ErrorContainer Grid.Row="9" FieldName="OauthServerUrl"
                                 Errors="{Binding $parent.DataContext.Errors}">
            <controls:ErrorContainer.Control>
                <TextBox Text="{Binding $parent[3].DataContext.OauthServerUrl, Mode=TwoWay}"
                         IsVisible="{Binding $parent[3].DataContext.SupportOAuthServerUrl}"/>
            </controls:ErrorContainer.Control>
        </controls:ErrorContainer>


        <Label Grid.Row="10" Content="{i18n:Localize OauthRedirectUrl}" Margin="0,12,0,0"
               IsVisible="{Binding SupportOAuth}"/>
        <controls:ErrorContainer Grid.Row="11" FieldName="OauthRedirectUrl"
                                 Errors="{Binding $parent.DataContext.Errors}">
            <controls:ErrorContainer.Control>
                <TextBox Text="{Binding $parent[3].DataContext.OauthRedirectUrl, Mode=TwoWay}"
                         IsVisible="{Binding $parent[3].DataContext.SupportOAuth}"/>
            </controls:ErrorContainer.Control>
        </controls:ErrorContainer>

        <Label Grid.Row="12" Content="{i18n:Localize OauthAppName}" Margin="0,12,0,0"
               IsVisible="{Binding SupportOAuth}"/>
        <controls:ErrorContainer Grid.Row="13" FieldName="OauthAppId"
                                 Errors="{Binding $parent.DataContext.Errors}">
            <controls:ErrorContainer.Control>
                <TextBox Text="{Binding $parent[3].DataContext.OauthAppName, Mode=TwoWay}"
                         IsVisible="{Binding $parent[3].DataContext.SupportOAuth}"/>
            </controls:ErrorContainer.Control>
        </controls:ErrorContainer>

        <Label Grid.Row="14" Content="{i18n:Localize OauthAppId}" Margin="0,12,0,0"
               IsVisible="{Binding SupportOAuth}"/>
        <controls:ErrorContainer Grid.Row="15" FieldName="OauthAppId"
                                 Errors="{Binding $parent.DataContext.Errors}">
            <controls:ErrorContainer.Control>
                <TextBox Text="{Binding $parent[3].DataContext.OauthAppId, Mode=TwoWay}"
                         IsVisible="{Binding $parent[3].DataContext.SupportOAuth}"/>
            </controls:ErrorContainer.Control>
        </controls:ErrorContainer>

        <Label Grid.Row="16" Content="{i18n:Localize OauthAppSecret}" Margin="0,12,0,0"
               IsVisible="{Binding SupportOAuth}"/>
        <controls:ErrorContainer Grid.Row="17" FieldName="OauthAppSecret"
                                 Errors="{Binding $parent.DataContext.Errors}">
            <controls:ErrorContainer.Control>
                <TextBox Text="{Binding $parent[3].DataContext.OauthAppSecret, Mode=TwoWay}"
                         IsVisible="{Binding $parent[3].DataContext.SupportOAuth}"/>
            </controls:ErrorContainer.Control>
        </controls:ErrorContainer>

        <!-- Connects with the typed settings: login, folder, free space -->
        <StackPanel Grid.Row="18" Spacing="8" Margin="0,14,0,0">
            <Button HorizontalAlignment="Left" Click="OnTestConnectionClick" IsEnabled="{Binding !IsTesting}"
                    AutomationProperties.Name="{i18n:Localize TestConnection}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="LanConnect" Width="16" Height="16" />
                    <TextBlock Text="{i18n:Localize TestConnection}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsTesting}"
                       Text="{i18n:Localize TestingConnection}" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding TestSucceeded}">
                <mi:MaterialIcon Kind="CheckCircle" Width="16" Height="16" VerticalAlignment="Top"
                                 Foreground="{DynamicResource SuccessBrush}" />
                <TextBlock TextWrapping="Wrap" Text="{Binding TestMessage}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding TestFailed}">
                <mi:MaterialIcon Kind="AlertCircle" Width="16" Height="16" VerticalAlignment="Top"
                                 Foreground="{DynamicResource DangerBrush}" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Text="{Binding TestMessage}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
