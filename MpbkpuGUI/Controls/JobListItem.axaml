<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="clr-namespace:Projektanker.Icons.Avalonia;assembly=Projektanker.Icons.Avalonia"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             xmlns:models="clr-namespace:MpbkpuGUI.Abstracts"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="MpbkpuGUI.Controls.JobListItem">
    <Design.DataContext>
        <models:Job />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:IsBackupJobConverter x:Key="IsBackupJobConverter"/>
        <converters:DateTimeConverter x:Key="DateTimeConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <i:Icon Name="Icon" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" FontSize="32" Value="fas fa-archive" Margin="0,0,12,0" />

        <TextBlock Grid.Row="0" Grid.Column="1" Classes="Main" Text="{Binding Path=Name}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Classes="Secondary" Text="{Binding Path=Source.FullPath}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Classes="Secondary" Text="{Binding Path=Destination.FullPath}" />

        <TextBlock Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" FontSize="16" VerticalAlignment="Center" Text="{Binding LastRun, Converter={StaticResource DateTimeConverter}}" />
        <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
            <Button Click="OnOpenClick" ToolTip.Tip="{i18n:Localize BrowseBackup}"
                    IsEnabled="{Binding ., Converter={StaticResource IsBackupJobConverter}}">
                <i:Icon Value="fas fa-folder-open"></i:Icon>
            </Button>
            <Button Click="OnRunClick" ToolTip.Tip="{i18n:Localize RunBackup}">
                <i:Icon Value="fas fa-play"></i:Icon>
            </Button>
            <Button Click="OnSettingsClick" ToolTip.Tip="{i18n:Localize BackupSettings}">
                <i:Icon Value="fas fa-cogs"></i:Icon>
            </Button>
            <Button Click="OnDeleteClick" ToolTip.Tip="{i18n:Localize DeleteBackup}">
                <Button.Styles>
                    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="DarkRed"/>
                    </Style>
                </Button.Styles>
                <i:Icon Value="fas fa-trash"></i:Icon>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
