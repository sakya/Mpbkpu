<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             xmlns:models="clr-namespace:MpbkpuGUI.Abstracts"
             xmlns:converters="clr-namespace:MpbkpuGUI.Converters"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="120"
             x:Class="MpbkpuGUI.Controls.JobListItem">
    <UserControl.Resources>
        <converters:IsBackupJobConverter x:Key="IsBackupJobConverter"/>
        <converters:DateTimeConverter x:Key="DateTimeConverter"/>
        <converters:EnumToLocalizedStringConverter x:Key="EnumToLocalizedStringConverter"/>
        <converters:BackupResultToColorConverter x:Key="BackupResultToColorConverter"/>
    </UserControl.Resources>

    <Border Classes="card hoverable" Padding="20">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Name="IconTile" Classes="iconTile">
                <mi:MaterialIcon Name="Icon" Kind="BackupOutline" />
            </Border>

            <StackPanel Grid.Column="1" Margin="20,0" Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="title" Text="{Binding Name}" VerticalAlignment="Center" />
                    <Border Classes="chip">
                        <TextBlock Name="TypeText" />
                    </Border>
                    <Border Classes="chip" IsVisible="{Binding Encrypted, FallbackValue=False}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="LockOutline" Width="12" Height="12" Foreground="{DynamicResource SubtleTextBrush}" />
                            <TextBlock Text="{i18n:Localize Encrypted}" />
                        </StackPanel>
                    </Border>
                    <Border Classes="chip" IsVisible="{Binding IsCompressed, FallbackValue=False}">
                        <TextBlock Text="{i18n:Localize Compressed}" />
                    </Border>
                    <!-- Automatic runs: days and time, the next run in the tooltip -->
                    <Border Name="ScheduleChip" Classes="chip" IsVisible="False">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="ClockOutline" Width="12" Height="12" Foreground="{DynamicResource SubtleTextBrush}" />
                            <TextBlock Name="ScheduleText" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Name="Paths" Classes="mono" />

                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding LastResult, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding LastResult, Converter={StaticResource BackupResultToColorConverter}}" />
                        <TextBlock FontSize="13" VerticalAlignment="Center"
                                   Foreground="{Binding LastResult, Converter={StaticResource BackupResultToColorConverter}}"
                                   Text="{Binding LastResult, Converter={StaticResource EnumToLocalizedStringConverter}, ConverterParameter=Result_}" />
                    </StackPanel>
                    <TextBlock Classes="muted" VerticalAlignment="Center"
                               IsVisible="{Binding LastRun, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Run Text="{i18n:Localize LastRunLabel}" /><Run Text=": " /><Run Text="{Binding LastRun, Converter={StaticResource DateTimeConverter}}" />
                    </TextBlock>
                    <!-- The last run was automatic: its log can be opened -->
                    <Button Name="LogButton" Classes="Small" IsVisible="False" VerticalAlignment="Center" Click="OnOpenLogClick"
                            ToolTip.Tip="{i18n:Localize OpenLog}" AutomationProperties.Name="{i18n:Localize AutomaticRunLog}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <mi:MaterialIcon Kind="ClockOutline" Width="12" Height="12" />
                            <TextBlock Text="{i18n:Localize AutomaticRunLog}" />
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding LastRun, Converter={x:Static ObjectConverters.IsNull}}">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" />
                        <TextBlock Classes="muted" VerticalAlignment="Center" Text="{i18n:Localize NeverRun}" />
                    </StackPanel>
                </StackPanel>

                <!-- Space of every destination (DestinationSpaceView) -->
                <StackPanel Name="SpaceList" Spacing="4" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="icon" Click="OnOpenClick" ToolTip.Tip="{i18n:Localize History}" AutomationProperties.Name="{i18n:Localize History}"
                        IsVisible="{Binding ., Converter={StaticResource IsBackupJobConverter}}">
                    <mi:MaterialIcon Kind="History" />
                </Button>
                <Button Classes="icon" Click="OnCopyCommandClick" ToolTip.Tip="{i18n:Localize CopyCommand}" AutomationProperties.Name="{i18n:Localize CopyCommand}">
                    <mi:MaterialIcon Kind="Console" />
                </Button>
                <Button Classes="icon" Click="OnSettingsClick" ToolTip.Tip="{i18n:Localize Settings}" AutomationProperties.Name="{i18n:Localize Settings}">
                    <mi:MaterialIcon Kind="Tune" />
                </Button>
                <Button Classes="icon dangerHover" Click="OnDeleteClick" ToolTip.Tip="{i18n:Localize Delete}" AutomationProperties.Name="{i18n:Localize Delete}">
                    <mi:MaterialIcon Kind="DeleteOutline" />
                </Button>
                <Button Classes="accent" Click="OnRunClick" AutomationProperties.Name="{i18n:Localize Run}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="Play" Width="16" Height="16" />
                        <TextBlock Name="RunText" Text="{i18n:Localize Run}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
