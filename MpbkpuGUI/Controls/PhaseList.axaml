<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i18n="clr-namespace:MpbkpuGUI.Localizer"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="240"
             x:Class="MpbkpuGUI.Controls.PhaseList">
    <UserControl.Styles>
        <!-- Phase list: icon and name colored by the state of the phase -->
        <Style Selector="mi|MaterialIcon.phase">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <Style Selector="mi|MaterialIcon.phase.done">
            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="mi|MaterialIcon.phase.running">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
        </Style>
        <Style Selector="mi|MaterialIcon.phase.failed">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.phase">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        </Style>
        <Style Selector="TextBlock.phase.running">
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.phase.inactive">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>
        <!-- Overall progress: one segment per phase -->
        <Style Selector="Border.segment">
            <Setter Property="Height" Value="6" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{DynamicResource LineBrush}" />
        </Style>
        <Style Selector="Border.segment.done">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.segment.running">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Border.segment.failed">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Every phase of the job with its state, so a job is clearly not over when its files are done -->
    <StackPanel Spacing="6">
        <TextBlock Classes="muted" FontSize="12" Text="{i18n:Localize Phases}" />
        <ItemsControl Name="List">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <mi:MaterialIcon Classes="phase" Kind="{Binding Icon}" VerticalAlignment="Center"
                                         Classes.done="{Binding IsDone}" Classes.running="{Binding IsRunning}"
                                         Classes.failed="{Binding IsFailed}" />
                        <TextBlock Grid.Column="1" Classes="phase" Margin="10,0,8,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip.Tip="{Binding Name}"
                                   Classes.running="{Binding IsRunning}" Classes.inactive="{Binding IsInactive}" />
                        <TextBlock Grid.Column="2" Classes="muted" FontSize="12" VerticalAlignment="Center"
                                   Text="{Binding Detail}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Name="Segments" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
