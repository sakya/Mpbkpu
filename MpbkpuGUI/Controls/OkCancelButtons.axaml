<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="60"
             x:Class="MpbkpuGUI.Controls.OkCancelButtons">

    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <Button Name="Cancel" MinWidth="120" Content="{Binding CancelText}"
                IsVisible="{Binding CancelVisible}" IsCancel="True" />
        <Button Name="Ok" Classes="Ok accent" MinWidth="120" Content="{Binding OkText}"
                IsEnabled="{Binding OkEnabled}" IsDefault="True" />
    </StackPanel>
</UserControl>
