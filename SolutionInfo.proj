<Project>
  <PropertyGroup>
    <AssemblyTitle>Multi Platform Backup Utility</AssemblyTitle>
    <Description>A multi platform backup utility with encryption and compression feature.
Supports local and remote file system.

Supported file system schemes:
  dropbox://
  ftp://
  mediafire://
  mega://
  nextcloud://
  onedrive://
  pcloud://
  sftp://
  smb://</Description>
    <Authors>Paolo Iommarini</Authors>
    <Copyright>Copyright © 2022, Paolo Iommarini</Copyright>
    <Version>0.2.0.0</Version>
  </PropertyGroup>
</Project>
